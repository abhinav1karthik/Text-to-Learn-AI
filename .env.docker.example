# Copy this file to .env.docker and fill in your real values.
# Run with: docker compose --env-file .env.docker up --build

# Frontend build-time configuration.
# Keep VITE_API_BASE_URL empty when using the Docker frontend because Nginx proxies /api to the backend container.
VITE_API_BASE_URL=
VITE_AUTH0_DOMAIN=your-auth0-domain.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-spa-client-id
VITE_AUTH0_AUDIENCE=https://text-to-learn-api

# Backend Auth0 configuration.
AUTH0_ISSUER_URI=https://your-auth0-domain.us.auth0.com/
AUTH0_AUDIENCE=https://text-to-learn-api
# Optional. If omitted, the backend derives it from AUTH0_ISSUER_URI.
AUTH0_JWK_SET_URI=https://your-auth0-domain.us.auth0.com/.well-known/jwks.json

# Backend AI and external API configuration.
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
YOUTUBE_API_KEY=your-youtube-api-key

# Optional Cloudflare R2 audio storage.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=text-to-learn-audio

# Optional: uncomment these if you want Docker backend to use Neon instead of the Postgres container.
# These intentionally use DOCKER_ prefixes so normal local SPRING_DATASOURCE_* exports
# cannot accidentally override the Docker PostgreSQL container.
# DOCKER_SPRING_DATASOURCE_URL=jdbc:postgresql://your-neon-host/text-to-learn?sslmode=require&channelBinding=require
# DOCKER_SPRING_DATASOURCE_USERNAME=neondb_owner
# DOCKER_SPRING_DATASOURCE_PASSWORD=your-neon-password
